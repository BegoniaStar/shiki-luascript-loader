{
  "schemaVersion": 2,
  "package": {
    "name": "Shiki LuaScript Loader",
    "version": "0.1.0",
    "authors": ["BegoniaHe","星·麒"],
    "license": "AGPL-3.0-only",
    "description": "在 SealDice 1.6.0 中加载受控的 Dice! Lua 插件。",
    "homepage": "https://github.com/BegoniaStar/shiki-luascript-loader"
  },
  "build": {
    "entry": "src/index.ts",
    "ecmaTarget": "es6",
    "bundleFileName": "shiki-luascript-loader.js"
  },
  "sealDice": {
    "buildTarget": ["1.6.0"],
    "defaultTarget": "1.6.0"
  },
  "release": {
    "directory": "release",
    "checksum": "sha256",
    "artifactPolicy": {
      "forbiddenPaths": [],
      "forbiddenExtensions": [".map"]
    }
  },
  "sealpack": {
    "packageId": "BegoniaHe/shiki-luascript-loader",
    "minSealDice": "1.6.0",
    "contents": {
      "scripts": {
        "bundle": true,
        "path": "scripts/shiki-luascript-loader.js"
      }
    },
    "dependencies": {},
    "permissions": {
      "network": false,
      "networkHosts": [],
      "acknowledgeUnrestrictedNetwork": false,
      "fileRead": [],
      "fileWrite": [],
      "dangerous": false,
      "httpServer": false,
      "ipc": []
    },
    "readme": "README.md",
    "assets": [
      "assets/dice-lua/index.json",
      "assets/LICENSE",
      "assets/screenshots/master-import-runtime.png"
    ],
    "store": {
      "category": "tool",
      "icon": "",
      "banner": "",
      "screenshots": ["assets/screenshots/master-import-runtime.png"]
    }
  }
}
